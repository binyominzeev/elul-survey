# Másold le ezt a fájlt .env néven, és töltsd ki a saját értékeiddel.
# A .env fájlt SOSE commitold (a .gitignore már kizárja).

# Titkos kulcs a /api/export végponthoz. Ha üresen hagyod, a végpont ki van kapcsolva.
EXPORT_KEY=

# A bejelentkezési session titkosításához használt, hosszú, véletlenszerű string.
# Generálás: openssl rand -hex 32
SESSION_SECRET=

# Pocket ID OIDC beállítások (auth.binjomin.hu)
POCKET_ID_ISSUER=https://auth.binjomin.hu
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=

# A nyilvánosan elérhető domain, ahol az alkalmazás fut (ez alapján áll össze a callback URL).
BASE_URL=https://elul.binjomin.hu

PORT=3000
